# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── QQ互联登录 ──────────────────────────────────────────────────
QQ_APP_ID=                # QQ互联网站应用 App ID（connect.qq.com → 应用管理）
QQ_APP_KEY=               # QQ互联网站应用 App Key（密钥，勿泄露）
SITE_URL=                 # 站点根地址，如 https://market.ec-crystal-war.com（不填则自动从请求头推断）

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
